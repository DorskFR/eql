diff --git a/tools/compare_headless_gui.sh b/tools/compare_headless_gui.sh
new file mode 100755
index 0000000..c86a442
--- /dev/null
+++ b/tools/compare_headless_gui.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# usage: compare_headless_gui.sh <source-log> <lines-to-append> <run-seconds>
+set -euo pipefail
+
+FORK="$(cd "$(dirname "$0")/.." && pwd)"
+SRC="${1:-$FORK/reallog.txt}"
+TAIL_LINES="${2:-6000}"
+RUN_S="${3:-40}"
+PY=/usr/bin/python3
+WORK=/tmp/eqlhl
+UPSTREAM="${UPSTREAM:-/home/dorsk/Documents/eql/tmp/upstream}"
+
+rm -rf "$WORK"; mkdir -p "$WORK"/{gui,headless,logs}
+cp "$UPSTREAM"/*.py "$UPSTREAM"/*.json.gz "$WORK/gui/" 2>/dev/null || true
+cp "$FORK"/*.py "$FORK"/*.json.gz "$WORK/headless/" 2>/dev/null || true
+
+seed() { head -100 "$SRC" > "$1"; }
+LOG_G="$WORK/logs/eqlog_Guitest_erudin.txt"
+LOG_H="$WORK/logs/eqlog_Guitest_erudin.txt"   # same file, both tail it
+seed "$LOG_G"
+
+echo "== launching GUI overlay (Xvfb) and headless runner on $LOG_G =="
+xvfb-run -a -s "-screen 0 1280x1024x24" \
+  "$PY" "$WORK/gui/eql_dps_meter.py" "$LOG_G" >"$WORK/gui.out" 2>&1 &
+GUI_PID=$!
+"$PY" "$WORK/headless/eql_dps_meter.py" --headless "$LOG_G" \
+  >"$WORK/headless.out" 2>&1 &
+HL_PID=$!
+
+sleep 4
+echo "== appending lines 101..$TAIL_LINES =="
+sed -n "101,${TAIL_LINES}p" "$SRC" >> "$LOG_G"
+sleep "$RUN_S"
+
+echo "== stopping (SIGTERM: headless flushes, GUI relies on its 15s autosave) =="
+kill -TERM "$HL_PID" 2>/dev/null || true
+sleep 2
+pkill -TERM -P "$GUI_PID" 2>/dev/null || true
+kill -TERM "$GUI_PID" 2>/dev/null || true
+wait "$HL_PID" 2>/dev/null || true
+sleep 1
+
+echo; echo "== GUI  =="; cat "$WORK"/gui/eql_alltime_*.json
+echo; echo "== HEADLESS =="; cat "$WORK"/headless/eql_alltime_*.json
+echo; echo "== DIFF (exact) =="
+diff <(cat "$WORK"/gui/eql_alltime_*.json) \
+     <(cat "$WORK"/headless/eql_alltime_*.json) && echo "IDENTICAL"
