diff --git a/eql_headless.py b/eql_headless.py
new file mode 100644
index 0000000..8176e0f
--- /dev/null
+++ b/eql_headless.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""
+EQL Headless Runner
+===================
+Runs the DPS meter's lifetime-stats layer (AllTimeStore) with no GUI: no
+tkinter import, no window, no desktop. Same LogWatcher/CombatTracker/
+AllTimeStore objects the overlay uses, driven by a plain loop instead of
+tk's `after` scheduler, so the eql_alltime_*.json it writes is produced by
+exactly the same code as the overlay's.
+
+Entry point:  python eql_dps_meter.py --headless <eqlog file>
+
+Cadence mirrors the overlay: the log is polled every POLL_INTERVAL_MS and
+AllTimeStore.tick() runs on that same beat, while CombatTracker.maybe_timeout()
+runs on the RENDER_INTERVAL_MS beat (in the overlay that call lives in
+render(), not poll()). Getting both beats right matters: without
+maybe_timeout a fight never ends when the log goes quiet, and combat_secs
+would keep accruing through AFK time.
+
+SIGINT/SIGTERM flush the store before exiting, the way quit_app() does.
+
+Settings are read but never written -- a headless run must not clobber the
+overlay's saved window position or log_path.
+"""
+
+import os
+import signal
+import sys
+import time
+
+from eql_overlay_common import LogWatcher, Settings, SEED_BYTES, POLL_INTERVAL_MS
+from eql_combat_tracker import CombatTracker
+from eql_spell_db import SPELL_DB
+import eql_dps_meter as meter
+
+
+def _active_timeout(settings):
+    """The overlay's active_timeout(), read-only (eql_dps_meter.run_overlay)."""
+    layout = settings.get("layout", "vertical")
+    if layout in ("tri", "tri_h"):
+        mode = "hour"
+    else:
+        u = settings.get("units", "sec")
+        mode = u if u in ("sec", "min", "hour") else "sec"
+    keys = {"sec": "idle_timeout", "min": "idle_timeout_min",
+            "hour": "idle_timeout_hour"}
+    defaults = {"sec": 45, "min": 60, "hour": 3600}
+    return float(settings.get(keys[mode], defaults[mode]))
+
+
+class HeadlessMeter:
+    """The overlay's open_log() + poll() + quit_app(), minus the UI."""
+
+    def __init__(self, log_path, settings=None, verbose=False):
+        self.log_path = log_path
+        self.verbose = verbose
+        self.settings = settings if settings is not None else Settings(
+            meter.SETTINGS_FILE, {})
+        self.timeout = _active_timeout(self.settings)
+        SPELL_DB.set_game_dir_hint(
+            os.path.dirname(os.path.dirname(os.path.abspath(log_path))))
+        self.tracker = CombatTracker(
+            self_name=self._char_name(log_path), idle_timeout=self.timeout)
+        self.watcher = LogWatcher(log_path)
+        self.watcher.add_handler(self.tracker.handle_line)
+        self.watcher.seed(max_bytes=SEED_BYTES)
+        self.alltime = meter.AllTimeStore(log_path, self.tracker.player_classes)
+        self.alltime.snapshot_baseline(self.tracker)
+        self.classes = self.tracker.player_classes
+        self._stop = False
+
+    @staticmethod
+    def _char_name(path):
+        import re
+        m = re.match(r"eqlog_([A-Za-z]+)", os.path.basename(path))
+        return m.group(1) if m else "You"
+
+    def stop(self, *_):
+        self._stop = True
+
+    def poll_once(self):
+        """One beat of the overlay's poll(): identical body."""
+        try:
+            self.watcher.poll()
+            tracker = self.tracker
+            in_combat = tracker.current is not None
+            if tracker.player_classes != self.classes:
+                old = self.alltime
+                if old:
+                    old.tick(tracker, in_combat)
+                    old.save()
+                store = meter.AllTimeStore(self.log_path, tracker.player_classes)
+                store.snapshot_baseline(tracker)
+                self.alltime = store
+                self.classes = tracker.player_classes
+                self._log(f"build switch -> {tracker.player_classes} "
+                          f"({os.path.basename(store.path)})")
+            self.alltime.tick(tracker, in_combat)
+        except Exception as exc:            # never let a parse hiccup stop tailing
+            self._log(f"poll error: {exc!r}")
+
+    def run(self, max_seconds=None):
+        self._log(f"headless meter on {self.log_path}")
+        self._log(f"alltime -> {self.alltime.path} "
+                  f"(idle_timeout {self.timeout:g}s)")
+        started = time.monotonic()
+        next_poll = started
+        next_render = started
+        poll_s = POLL_INTERVAL_MS / 1000.0
+        render_s = meter.RENDER_INTERVAL_MS / 1000.0
+        while not self._stop:
+            now = time.monotonic()
+            if now >= next_render:
+                self.tracker.maybe_timeout()
+                next_render = now + render_s
+            if now >= next_poll:
+                self.poll_once()
+                next_poll = now + poll_s
+            if max_seconds is not None and now - started >= max_seconds:
+                break
+            time.sleep(max(0.0, min(next_render, next_poll) - time.monotonic()))
+        self.shutdown()
+
+    def shutdown(self):
+        """quit_app()'s flush."""
+        self.alltime.save()
+        self._log(f"saved {self.alltime.path}")
+
+    def _log(self, msg):
+        # a PyInstaller console=False build has no usable stdout
+        if not self.verbose:
+            return
+        try:
+            print(f"[eql-headless] {msg}", flush=True)
+        except (OSError, ValueError, AttributeError):
+            pass
+
+
+def run(log_path, verbose=True, max_seconds=None):
+    m = HeadlessMeter(log_path, verbose=verbose)
+    for sig in (signal.SIGINT, getattr(signal, "SIGTERM", None),
+                getattr(signal, "SIGBREAK", None)):
+        if sig is not None:
+            try:
+                signal.signal(sig, m.stop)
+            except (ValueError, OSError):
+                pass
+    m.run(max_seconds=max_seconds)
+    return m
+
+
+def main(argv):
+    """`eql_dps_meter.py --headless <log> [--seconds N] [--quiet]`"""
+    log_path = ""
+    seconds = None
+    verbose = True
+    i = 0
+    while i < len(argv):
+        a = argv[i]
+        if a == "--seconds":
+            i += 1
+            seconds = float(argv[i])
+        elif a == "--quiet":
+            verbose = False
+        elif not log_path:
+            log_path = a
+        i += 1
+    if not log_path:
+        try:
+            log_path = Settings(meter.SETTINGS_FILE, {}).get("log_path", "")
+        except Exception:
+            log_path = ""
+    if not log_path or not os.path.isfile(log_path):
+        raise SystemExit(
+            "usage: python eql_dps_meter.py --headless <eqlog file> "
+            "[--seconds N] [--quiet]")
+    run(log_path, verbose=verbose, max_seconds=seconds)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
