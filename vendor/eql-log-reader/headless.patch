index 0000000..54568c1
--- /dev/null
+++ b/eql_quest_cli.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""
+EQL Quest CLI
+=============
+Curate the tracked-quest list without the Atlas overlay's Quest window.
+
+Everything the QuestWindow does to QuestState -- add, track, reorder,
+remove, hand-credit an item you already owned -- is a plain method call;
+only the *presentation* was tkinter. This module exposes those calls so a
+headless install (a daemon, a server, a scripted setup) can build the same
+list, after which `eql_atlas.py --replay` credits loot against it.
+
+    python eql_atlas.py --quest <eqlog file> search "bone chips"
+    python eql_atlas.py --quest <eqlog file> add "bone chips" --pick 0
+    python eql_atlas.py --quest <eqlog file> track "<qid>"
+    python eql_atlas.py --quest <eqlog file> list
+    python eql_atlas.py --quest <eqlog file> have "<qid>" "Bone Chips" 4
+    python eql_atlas.py --quest <eqlog file> remove "<qid>"
+
+`--era N` (0 classic, 1 kunark, 2 velious, 3 luclin, 4 pop) gates search
+exactly as the overlay's era checkboxes do; the default is classic-only,
+matching a fresh settings file.
+"""
+
+import sys
+
+from eql_quest import QuestDB, QuestState
+
+
+def _fmt(qdb, state, qid):
+    q = qdb.get(qid)
+    name = q["name"] if q else "(not in DB)"
+    zone = qdb.zones.get(q["z"], q["z"]) if q else "?"
+    got, need = state.progress(qdb, qid)
+    marks = "*" if state.current() == qid else " "
+    conf = "confirmed" if state.is_confirmed(qid) else ""
+    return (f" {marks} {name} -- {q['n'] if q else '?'} [{zone}] "
+            f"{got}/{need} {conf}\n     qid: {qid}")
+
+
+def _resolve(qdb, state, arg, era, pick):
+    """A qid verbatim, or the `pick`-th search hit for a term."""
+    if "|" in arg:
+        return arg
+    hits = qdb.search(arg, era)
+    if not hits:
+        raise SystemExit(f"no quest matches {arg!r} at era {era}")
+    if pick >= len(hits):
+        raise SystemExit(f"--pick {pick} out of range ({len(hits)} hits)")
+    return hits[pick]["qid"]
+
+
+def run(state_path, argv):
+    if not argv:
+        raise SystemExit(__doc__)
+    era = 0
+    pick = 0
+    args = []
+    i = 0
+    while i < len(argv):
+        if argv[i] == "--era":
+            i += 1
+            era = int(argv[i])
+        elif argv[i] == "--pick":
+            i += 1
+            pick = int(argv[i])
+        else:
+            args.append(argv[i])
+        i += 1
+
+    from eql_atlas import APP_DIR
+    qdb = QuestDB(APP_DIR)
+    if not qdb.ok:
+        raise SystemExit("no quest DB -- eql_quest_db.json.gz is missing")
+    state = QuestState(state_path)
+    cmd, rest = args[0], args[1:]
+
+    if cmd == "list":
+        cur = state.current()
+        print(f"{state_path}\n{len(state.data['order'])} tracked, "
+              f"{state.confirmed_count()} confirmed"
+              + (f", tracking {cur}" if cur else ", tracking nothing"))
+        for qid in state.data["order"]:
+            print(_fmt(qdb, state, qid))
+
+    elif cmd == "search":
+        hits = qdb.search(" ".join(rest), era)
+        print(f"{len(hits)} hit(s) at era {era}")
+        for n, q in enumerate(hits[:25]):
+            print(f"[{n}] {q['name']} -- {q['n']} "
+                  f"[{qdb.zones.get(q['z'], q['z'])}]\n     qid: {q['qid']}")
+
+    elif cmd in ("add", "track"):
+        qid = _resolve(qdb, state, " ".join(rest), era, pick)
+        added = state.add(qid)
+        if cmd == "track":
+            state.set_current(qid)
+        print(("added " if added else "already on the list: ")
+              + f"{qdb.get(qid)['name']}\n{_fmt(qdb, state, qid)}")
+
+    elif cmd == "remove":
+        qid = _resolve(qdb, state, " ".join(rest), era, pick)
+        state.remove(qid)
+        print(f"removed {qid}")
+
+    elif cmd == "move":
+        qid = _resolve(qdb, state, rest[0], era, pick)
+        state.move(qid, int(rest[1]))
+        print(f"moved {qid} by {rest[1]}")
+
+    elif cmd == "have":
+        qid = _resolve(qdb, state, rest[0], era, pick)
+        iid = qdb.item_id(rest[1])
+        if not iid:
+            raise SystemExit(f"unknown item {rest[1]!r}")
+        state.set_have(qid, iid, int(rest[2]))
+        print(_fmt(qdb, state, qid))
+
+    else:
+        raise SystemExit(__doc__)
+    state.save()
+
+
+def main(argv):
+    if len(argv) < 2:
+        raise SystemExit(__doc__)
+    from eql_atlas import APP_DIR, char_server_from
+    from eql_overlay_common import data_path
+    char, server = char_server_from(argv[0])
+    run(data_path(f"eql_quest_{char}_{server}.json", APP_DIR), argv[1:])
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
