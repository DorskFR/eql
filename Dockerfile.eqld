FROM rust:1.96-slim AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p eqld

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1000 --user-group eqld
COPY --from=builder /build/target/release/eqld /usr/local/bin/eqld
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/eqld"]
